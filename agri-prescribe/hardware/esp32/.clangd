# .clangd — Clangd configuration for Arduino/ESP32 firmware
#
# Arduino .ino files cannot be parsed by a generic C/C++ toolchain.
# This file suppresses Clangd errors that arise from missing ESP32 SDK headers.
#
# To properly compile and flash this firmware, use:
#   - Arduino IDE (recommended for beginners)
#   - PlatformIO: run `pio run` in this directory (recommended for VS Code)
#
# The firmware code itself is correct Arduino C++ — these are IDE-only errors.

CompileFlags:
  # Suppress errors caused by missing Arduino/ESP32 SDK include paths.
  # Clangd cannot resolve ESP32-specific headers (WiFi.h, ArduinoJson.h, etc.)
  # without a compile_commands.json generated by Arduino IDE or PlatformIO.
  Add:
    - "-ferror-limit=0"
    - "-w"

Diagnostics:
  # Suppress all diagnostics for .ino files — they require Arduino toolchain
  Suppress:
    - "*"
  UnusedIncludes: None
  ClangTidy:
    Remove:
      - "*"
